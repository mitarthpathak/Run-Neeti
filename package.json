{
  "name": "run-neeti",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "concurrently -n \"WEB,API\" -c \"cyan,magenta\" \"npm run client\" \"npm run server\"",
    "client": "vite --port=5173 --host=0.0.0.0",
    "server": "npm start --prefix server",
    "dev": "npm start",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "npm test --prefix server"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "d3-force": "^3.0.0",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.4.1",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^15.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "description": "Upload a PDF and turn it into an interactive AI knowledge graph, study roadmap and quiz (React + Express + Gemini + MongoDB).",
