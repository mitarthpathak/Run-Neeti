# Copy this file to server/.env and fill in the values.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# Required: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Recommended: MongoDB connection string. Without it (or if it can't connect)
# data is kept in memory and lost when the server restarts.
# If the password contains special characters such as @ : / ? #, URL-encode them (@ -> %40).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/runneeti?appName=Cluster0

# Recommended: long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional: comma-separated Gemini models, tried in order (default shown).
# GEMINI_MODEL=gemini-flash-latest,gemini-flash-lite-latest

# Optional: only needed if the frontend is served from a different origin.
# CORS_ORIGIN=https://your-frontend.example.com

# Optional: API port for local development (default 3001).
# PORT=3001
